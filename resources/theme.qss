* {
  font-size: 10.5pt;
  color: #d6d7d8;
}
QMainWindow, QDialog, QWidget#appRoot, QWidget#loginRoot, QStackedWidget {
  background: #171a21;
}
QWidget { background-color: transparent; }
QFrame#windowBar {
  background: #101318;
  border-bottom: 1px solid #20252e;
}
QLabel#windowTitle {
  color: #9aa4b2;
  font-size: 9.5pt;
  font-weight: 600;
}
QPushButton#windowMinimize, QPushButton#windowMaximize, QPushButton#windowClose {
  min-height: 0;
  min-width: 0;
  padding: 0;
  border: none;
  border-radius: 6px;
  background: #171b22;
}
QPushButton#windowMinimize:hover, QPushButton#windowMaximize:hover { background: #28303a; }
QPushButton#windowClose:hover { background: #c84b4b; }
QPushButton#windowMinimize { image: url(:/icons/minimize.svg); }
QPushButton#windowMaximize { image: url(:/icons/maximize.svg); }
QPushButton#windowClose { image: url(:/icons/close.svg); }
QFrame#sidebar {
  background: #11151b;
  border-left: 1px solid #252a31;
}
QFrame#topbar, QFrame#statusBar {
  background: #1b2028;
  border-bottom: 1px solid #262d36;
}
QFrame#statusBar { border-top: 1px solid #262d36; border-bottom: none; }
QFrame#announcementBar {
  background: #24364a;
  border-bottom: 1px solid #31526f;
}
QLabel#announcementText { color: #c7e7ff; font-weight: 700; }
QFrame#hero {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #243748, stop:0.45 #1d2733, stop:1 #151a20);
  border: 1px solid #2c3d4d;
  border-radius: 8px;
}
QLabel#heroTitle {
  font-size: 26pt;
  font-weight: 800;
  color: #ffffff;
}
QFrame#card, QFrame#panel, QFrame#downloadItem, QFrame#friendItem, QFrame#libraryItem {
  background: #1f252d;
  border: 1px solid #2a313a;
  border-radius: 8px;
}
QFrame#card:hover, QFrame#libraryItem:hover {
  border: 1px solid #66c0f4;
  background: #222b35;
}
QLabel#storeImage, QLabel#detailBanner, QLabel#detailIcon {
  background: #12161c;
  border: 1px solid #2b333d;
  border-radius: 6px;
}
QLabel#brand {
  font-size: 18pt;
  font-weight: 800;
  color: #ffffff;
}
QLabel#pageTitle {
  font-size: 22pt;
  font-weight: 800;
  color: #ffffff;
}
QLabel#sectionTitle {
  font-size: 13.5pt;
  font-weight: 700;
  color: #ffffff;
}
QLabel#muted, QLabel#metadata { color: #8f98a4; }
QLabel#accent, QLabel#online { color: #66c0f4; font-weight: 700; }
QPushButton {
  min-height: 36px;
  padding: 0 14px;
  border: 1px solid #38414c;
  border-radius: 5px;
  background: #2a313b;
  color: #e6e8ea;
  font-weight: 600;
}
QPushButton:hover { background: #333c47; border-color: #52606f; }
QPushButton:pressed { background: #20262e; }
QPushButton:disabled { color: #68717c; background: #20252b; border-color: #2b3037; }
QPushButton#primary {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #75b022, stop:1 #588a1b);
  border-color: #7ac22a;
  color: #f6ffe9;
  font-weight: 800;
}
QPushButton#primary:hover {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #8bc53f, stop:1 #6ca129);
  border-color: #92d33f;
}
QPushButton#danger { background: #4b2529; border-color: #7c3b42; color: #ffb8be; }
QPushButton#nav {
  text-align: right;
  padding-right: 16px;
  border: none;
  border-radius: 4px;
  background: transparent;
  color: #9da7b3;
}
QPushButton#nav:hover { background: #1d252e; color: #ffffff; }
QPushButton#nav:checked {
  background: #24394b;
  color: #ffffff;
  border-right: 3px solid #66c0f4;
}
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
  min-height: 38px;
  padding: 0 11px;
  background: #12171d;
  border: 1px solid #303844;
  border-radius: 5px;
  selection-background-color: #315c7d;
  color: #e4e7eb;
}
QTextEdit, QPlainTextEdit { padding: 10px 12px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #66c0f4; }
QScrollArea, QScrollArea > QWidget > QWidget { border: none; background: #171a21; }
QScrollBar:vertical { width: 10px; background: #171a21; margin: 2px; }
QScrollBar::handle:vertical { min-height: 30px; background: #3a4654; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #526172; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QListWidget, QTreeWidget, QTableWidget, QTabWidget::pane {
  background: #171a21;
  border: 1px solid #2c333c;
  outline: none;
}
QListWidget::item { padding: 10px; border-radius: 4px; }
QListWidget::item:selected { background: #294158; }
QTabBar::tab {
  background: #1e242b;
  color: #939da9;
  padding: 10px 18px;
  border: 1px solid #2d353f;
  border-bottom: none;
}
QTabBar::tab:selected { color: #ffffff; background: #26313c; }
QProgressBar {
  min-height: 8px;
  max-height: 8px;
  border: none;
  border-radius: 3px;
  background: #303741;
  color: transparent;
}
QProgressBar::chunk { border-radius: 3px; background: #66c0f4; }
QCheckBox { spacing: 8px; }
QToolTip { background: #202731; color: #ffffff; border: 1px solid #45515f; padding: 6px; }
QMenu { background: #1d232b; border: 1px solid #343d48; padding: 6px; }
QMenu::item { padding: 8px 18px; border-radius: 4px; }
QMenu::item:selected { background: #294158; color: #ffffff; }
QMessageBox { background: #1b2028; }
